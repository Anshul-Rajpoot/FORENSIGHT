<%- include('partials/layout-top', {title:'FORENSIGHT - Face Generator'}) %>
<link rel="stylesheet" href="/css/Editor.module.css" />
<link rel="stylesheet" href="/css/AssetPanel.module.css" />
<link rel="stylesheet" href="/css/CanvasArea.module.css" />
<link rel="stylesheet" href="/css/LayersPanel.module.css" />
<link rel="stylesheet" href="/css/Toast.module.css" />
<style>
  .editor-shell {
    height: calc(100vh - 90px);
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: #0f172a;
    overflow: hidden;
  }

  .editor-layout {
    display: flex;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .editor-layout .panel {
    height: 100%;
    min-height: 0;
    box-sizing: border-box;
  }

  .editor-center {
    flex: 1;
    min-width: 0;
    min-height: 0;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;

    overflow-y: auto;
    overflow-x: hidden;

    padding: 20px;
    box-sizing: border-box;
  }

  .toast-message {
    position: fixed;
    bottom: 20px;
    right: 20px;
    padding: 12px 20px;
    border-radius: 8px;
    color: #fff;
    box-shadow: 0 4px 15px rgba(0,0,0,.3);
    z-index: 10000;
  }

  @media (max-width: 1000px) {
    .editor-shell {
      height: auto;
      min-height: calc(100vh - 90px);
      overflow: visible;
    }

    .editor-layout {
      flex-direction: column;
      overflow: visible;
    }

    .editor-layout .panel {
      width: 100%;
      height: auto;
      min-height: 0;
      max-height: 260px;
    }

    .asset-panel-scope.panel {
      overflow-y: auto;
    }

    .asset-panel-grid {
      grid-template-columns: repeat(6, 1fr);
    }

    .layer-panel {
      display: none;
    }

    .editor-center {
      overflow: visible;
      padding: 15px;
    }

    .canvas {
      margin-top: 10px !important;
      width: min(500px, 90vw) !important;
      height: auto !important;
    }
  }
</style>
<%- include('partials/header') %>
<div class="editor-shell editor-page-scope">
  <div class="editor-layout">
    <aside class="asset-panel-scope panel asset-panel">
      <h3 class="heading">Assets</h3>
      <div id="assetList"></div>
    </aside>

    <main class="canvas-area-scope area editor-center">
      <canvas id="faceCanvas" width="350" height="440" class="canvas"></canvas>
      <div class="controls">
        <div class="row">
          <button class="btn genderButton" type="button" ><label class="genderLabel">Gender : </label><select id="gender" class="genderSelect"><option value="">Select</option><option value="Any">Any</option><option value="Male">Male</option><option value="Female">Female</option><option value="Other">Other</option></select></button>
          <button class="btn" id="downloadBtn" type="button" style="height: 50px;">Download</button>
        </div>
        <div class="row"><button class="btn" id="deleteBtn" type="button">Delete</button><button class="btn" id="generateBtn" type="button">Generate</button></div>
        <div class="row"><button class="btn" id="upBtn" type="button">Layer Up</button><button class="btn" id="downBtn" type="button">Layer Down</button></div>
      </div>
      <div id="toastContainer" class="toast-scope container"></div>
    </main>

    <aside class="layers-panel-scope panel layer-panel">
      <h3 class="heading">Canvas Layers</h3>
      <p id="layerEmpty" class="empty">No layers yet.<br />Click an asset to add.</p>
      <div id="layerList"></div>
    </aside>
  </div>
</div>
<script src="/js/common.js"></script><script src="/js/editor.js"></script>
<%- include('partials/layout-bottom') %>
